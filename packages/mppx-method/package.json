{
  "name": "@picocash/mppx-method",
  "version": "0.1.0",
  "description": "MPP custom payment method 'picocash': challenge → credential → receipt with sub-100ms offline verification and accept-then-settle (spec/04)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@picocash/crypto": "*",
    "@picocash/sdk": "*"
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "@picocash/mint": "*",
    "hono": "^4.6.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
